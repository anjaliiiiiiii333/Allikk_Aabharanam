{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DigitalAccessoriesDatasetSchema",
  "description": "Validation schema for the Digital Accessories catalog in the Allikk Aabharanam project.",
  "type": "object",
  "required": ["version", "last_updated", "total_items", "accessories"],
  "properties": {
    "version": { "type": "string" },
    "last_updated": { "type": "string" },
    "total_items": { "type": "integer", "minimum": 0 },
    "accessories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "subcategory",
          "theme",
          "description",
          "materials",
          "palette",
          "dimensions",
          "anchor",
          "physics",
          "compatible_targets",
          "rarity",
          "sound_mappings"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "name": { "type": "string" },
          "category": {
            "type": "string",
            "enum": ["keychain", "charm", "hat", "bow", "pin", "sticker", "strap", "bell"]
          },
          "subcategory": { "type": "string" },
          "theme": { "type": "string" },
          "description": { "type": "string" },
          "materials": {
            "type": "array",
            "items": { "type": "string" }
          },
          "palette": {
            "type": "object",
            "required": ["primary", "secondary", "accent", "finish"],
            "properties": {
              "primary": { "type": "string" },
              "secondary": { "type": "string" },
              "accent": { "type": "string" },
              "finish": { "type": "string" }
            }
          },
          "dimensions": {
            "type": "object",
            "required": ["width_px", "height_px", "aspect_ratio"],
            "properties": {
              "width_px": { "type": "integer", "minimum": 1 },
              "height_px": { "type": "integer", "minimum": 1 },
              "aspect_ratio": { "type": "string" }
            }
          },
          "anchor": {
            "type": "object",
            "required": ["type", "offset_x", "offset_y", "hole_required"],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "top_right_hook",
                  "top_center_clip",
                  "corner_grommet",
                  "head_perch",
                  "center_pin",
                  "corner_wrap"
                ]
              },
              "offset_x": { "type": "integer" },
              "offset_y": { "type": "integer" },
              "hole_required": { "type": "boolean" }
            }
          },
          "physics": {
            "type": "object",
            "required": ["weight_g", "damping", "stiffness", "gravity_scale", "max_swing_deg"],
            "properties": {
              "weight_g": { "type": "number", "minimum": 0 },
              "damping": { "type": "number", "minimum": 0, "maximum": 1 },
              "stiffness": { "type": "number", "minimum": 0, "maximum": 1 },
              "gravity_scale": { "type": "number", "minimum": 0 },
              "max_swing_deg": { "type": "number", "minimum": 0, "maximum": 180 }
            }
          },
          "compatible_targets": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rarity": {
            "type": "string",
            "enum": ["common", "uncommon", "rare", "epic", "legendary"]
          },
          "sound_mappings": {
            "type": "object",
            "required": ["on_attach", "on_detach", "on_drag_move", "on_drag_release", "on_interact"],
            "properties": {
              "on_attach": { "type": "string" },
              "on_detach": { "type": "string" },
              "on_drag_move": { "type": "string" },
              "on_drag_release": { "type": "string" },
              "on_interact": { "type": "string" }
            }
          },
          "asset_status": {
            "type": "string",
            "enum": ["ready", "in_design", "planned"]
          },
          "asset_path": { "type": "string" }
        }
      }
    }
  }
}
